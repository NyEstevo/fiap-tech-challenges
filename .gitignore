# Ignore environment variable files

#fase-1
/fase-1/.env

#fase-2
/fase-2/analytics-service/.env
/fase-2/auth-service/.env
/fase-2/targeting-service/.env
/fase-2/flag-service/.env
/fase-2/evaluation-service/.env

#fase-3
# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
tfplan
plan.txt
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# manter os exemplos versionados, ignorar os tfvars reais que contenham segredos
# (neste projeto os tfvars nao tem segredos, entao terraform.tfvars fica versionado)

# Claude Code - configuracao local, nao versionar
/CLAUDE.md
.claude/settings.local.json

# Terraform dependency lock: versionar apenas nos root modules (bootstrap, envs/*),
# nunca nos modulos reutilizaveis (gerado pelos hooks terraform_validate/tflint)
fase-3/infra/terraform/modules/**/.terraform.lock.hcl
