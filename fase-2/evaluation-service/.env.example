# Porta que este serviço irá rodar
PORT=8004

# URL do Redis
REDIS_URL=redis://redis-db:6379/0

# URLs dos outros serviços internos
FLAG_SERVICE_URL=http://flag-service:8002
TARGETING_SERVICE_URL=http://targeting-service:8003
AUTH_SERVICE_URL=http://auth-service:8001
ANALYTICS_SERVICE_URL=http://analytics-service:8005

# Chave de API criada no auth-service para autenticar chamadas internas
# Crie com: POST /admin/keys (Authorization: Bearer <MASTER_KEY>)
SERVICE_API_KEY=

# Configuração AWS SQS
AWS_SQS_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/analytics-queue
AWS_REGION=us-east-1

# Intervalo de avaliação (segundos)
EVALUATION_INTERVAL=60
