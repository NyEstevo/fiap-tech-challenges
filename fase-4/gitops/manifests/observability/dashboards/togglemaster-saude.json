        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(kube_deployment_status_replicas_available{namespace=\"toggle\", deployment=~\"(${servico:pipe})-deployment\"} > 0) or vector(0)",
